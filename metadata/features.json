{
  "version": 1,
  "features": [
    {
      "id": "geoip",
      "description": "Provider-response normalization with explicit Quantumult X and Surge adapters.",
      "defaultEnabled": false,
      "providers": {
        "ipinfo": "https://ipinfo.io/json",
        "ipwho.de": "http://ipwho.de/json",
        "ip-api": "http://ip-api.com/json/"
      },
      "clients": {
        "quantumultX": {
          "artifacts": [
            "scripts/geoip.js",
            "fragments/geoip.conf"
          ],
          "kind": "general-fragment",
          "requiresPublicBaseUrl": true,
          "routing": "The native geo_location_checker supplies the response; the script only parses it.",
          "documentationBaseline": "1.5.5 build 914"
        },
        "surge": {
          "artifacts": [
            "scripts/geoip.js",
            "modules/geoip.sgmodule"
          ],
          "kind": "generic-panel",
          "routing": "One lookup request uses the existing policy named by the script argument, Proxy by default; it does not change a group selection or represent every request.",
          "minimumVersion": {
            "ios": "4.9.3",
            "macos": "5.7.5"
          }
        }
      },
      "validation": {
        "unit": "node-test",
        "hostContract": "node-vm",
        "nativeApp": "not-run",
        "liveApi": "Run separately; public IP responses are never committed as fixtures."
      },
      "sources": [
        "https://github.com/crossutility/Quantumult-X/blob/master/sample-location-with-script.js",
        "https://github.com/crossutility/Quantumult-X/blob/master/sample-fetch-opts-policy.js",
        "https://manual.nssurge.com/scripting/api.html",
        "https://manual.nssurge.com/scripting/generic.html",
        "https://manual.nssurge.com/tools/panel.html",
        "https://ipwho.de/",
        "https://ipinfo.io/developers",
        "https://ip-api.com/docs/api:json"
      ]
    },
    {
      "id": "search-redirect",
      "description": "Optional native Bing-to-Google 302 redirect when q is the first query parameter.",
      "defaultEnabled": false,
      "requiresMitmForHttps": [
        "www.bing.com"
      ],
      "clients": {
        "quantumultX": {
          "artifacts": [
            "rewrites/search-redirect.snippet"
          ],
          "kind": "rewrite-resource",
          "documentationBaseline": "1.5.5 build 914"
        },
        "surge": {
          "artifacts": [
            "rewrites/search-redirect.sgmodule"
          ],
          "kind": "sgmodule"
        }
      },
      "validation": {
        "unit": "encoded-query-positive-and-negative-fixtures",
        "hostContract": "native-syntax-reviewed-against-official-examples",
        "nativeApp": "not-run"
      },
      "sources": [
        "https://github.com/crossutility/Quantumult-X/blob/master/sample.conf",
        "https://github.com/crossutility/Quantumult-X/blob/master/sample-import-rewrite.snippet",
        "https://manual.nssurge.com/http/url-rewrite.html",
        "https://manual.nssurge.com/profile/module.html"
      ]
    },
    {
      "id": "anti-ad",
      "description": "Optional large domain-blocking ruleset; excluded from default profiles.",
      "defaultEnabled": false,
      "requiresMitm": false,
      "requiresScript": false,
      "license": "MIT",
      "sourceRegistry": "metadata/upstreams.json:anti-ad",
      "clients": {
        "quantumultX": {
          "artifacts": [
            "fragments/anti-ad.conf"
          ],
          "kind": "merge-fragment",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "surge": {
          "artifacts": [
            "modules/anti-ad.sgmodule"
          ],
          "kind": "sgmodule",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "loon": {
          "artifacts": [
            "fragments/anti-ad.conf"
          ],
          "kind": "merge-fragment",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "shadowrocket": {
          "artifacts": [
            "fragments/anti-ad.conf"
          ],
          "kind": "merge-fragment",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "egern": {
          "artifacts": [
            "modules/anti-ad.yaml"
          ],
          "kind": "native-module",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "stash": {
          "artifacts": [
            "modules/anti-ad.stoverride"
          ],
          "kind": "native-override",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "mihomo": {
          "artifacts": [
            "fragments/anti-ad.yaml"
          ],
          "kind": "merge-fragment",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        },
        "singBox": {
          "artifacts": [
            "fragments/anti-ad.json"
          ],
          "kind": "merge-fragment",
          "requiresPublicBaseUrl": true,
          "install": "Merge fragments manually and prepend the blocking rule; native module merge precedence must be checked in the application."
        }
      },
      "validation": {
        "unit": "node-test",
        "hostContract": "native-resource-schema and referenced-artifact checks",
        "nativeApp": "not-run"
      },
      "sources": [
        "https://github.com/privacy-protection-tools/anti-AD",
        "https://github.com/crossutility/Quantumult-X/blob/master/sample.conf",
        "https://manual.nssurge.com/rules/ruleset.html",
        "https://egernapp.com/docs/configuration/modules/",
        "https://egernapp.com/docs/configuration/rules/",
        "https://stash.wiki/configuration/override",
        "https://wiki.metacubex.one/en/config/rule-providers/",
        "https://sing-box.sagernet.org/configuration/rule-set/",
        "https://nsloon.app/docs/Rule/sub_rule/",
        "https://github.com/Loon0x00/LoonExampleConfig/blob/master/example.conf"
      ],
      "licenseScope": "Declared license of the direct anti-AD source; original credits are retained, no blanket claim about every aggregated origin."
    },
