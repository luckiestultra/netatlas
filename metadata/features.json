{
  "version": 1,
  "features": [
    {
      "id": "geoip",
      "description": "Provider-response normalization with QX/Surge adapters; QX Chinese country display uses pinned Unicode CLDR 48 while provider-supplied location fields remain unchanged.",
      "defaultEnabled": false,
      "providers": {
        "ipinfo": "https://ipinfo.io/json",
        "ipwho.de": "http://ipwho.de/json",
        "ip-api": "http://ip-api.com/json/",
        "ipwho.is": "http://ipwho.is/?lang=zh-CN"
      },
      "clients": {
        "quantumultX": {
          "artifacts": [
            "scripts/geoip.js",
            "fragments/geoip.conf"
          ],
          "kind": "general-fragment",
          "requiresPublicBaseUrl": true,
          "routing": "The native geo_location_checker supplies the response; the script only parses it.",
          "documentationBaseline": "1.5.5 build 914"
        },
        "surge": {
          "artifacts": [
            "scripts/geoip.js",
            "modules/geoip.sgmodule"
          ],
          "kind": "generic-panel",
          "routing": "One lookup request uses the existing policy named by the script argument, 节点选择 in the published module; it does not change a group selection or represent every request.",
          "minimumVersion": {
            "ios": "4.9.3",
            "macos": "5.7.5"
          }
        }
      },
      "validation": {
        "unit": "node-test: nested ipwho.is and IPinfo Lite/legacy schemas, strict success states, CLDR labels, compact location title, full IP and unabridged details.",
        "hostContract": "node-vm: generated QX final evaluation object with identity $done and once-only completion; Surge callback/watchdog contract. Native GUI execution is separate.",
        "nativeApp": "not-run",
        "liveApi": "Run separately; public IP responses are never committed as fixtures."
      },
      "sources": [
        "https://github.com/crossutility/Quantumult-X/blob/master/sample-location-with-script.js",
        "https://github.com/crossutility/Quantumult-X/blob/master/sample-fetch-opts-policy.js",
        "https://manual.nssurge.com/scripting/api.html",
        "https://manual.nssurge.com/scripting/generic.html",
        "https://manual.nssurge.com/tools/panel.html",
        "https://ipwho.de/",
        "https://ipinfo.io/developers",
        "https://ip-api.com/docs/api:json",
        "https://github.com/unicode-org/cldr/blob/acd6d88ae493633240e19a87a721076a8a75c310/common/main/zh.xml",
        "https://ipwhois.io/documentation",
        "https://ipinfo.io/developers/lite-api"
      ],
      "license": "MIT AND Unicode-3.0",
      "displayLocalization": {
        "source": "Unicode CLDR 48",
        "revision": "acd6d88ae493633240e19a87a721076a8a75c310",
        "sourcePath": "common/main/zh.xml",
        "license": "Unicode-3.0",
        "notice": "src/features/geoip/localization/NOTICE.md",
        "licensePath": "src/features/geoip/localization/LICENSE-Unicode",
        "rawProviderFieldsUnchanged": true,
        "quantumultXIpFields": [
          "subtitle",
          "ip",
          "description"
        ]
      }
    },
