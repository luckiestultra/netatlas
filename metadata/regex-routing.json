{
  "version": 1,
  "sourceRevision": "1daade8c4bb957d21d1f5c09c2b050d699e8e96c",
  "license": "MIT",
  "semantics": "Source-regex language equivalence is scoped to already-normalized lower-case ASCII hostnames without a trailing root dot. The expressions retain source anchors; no optional-dot widening or URL matching is added. Host normalization belongs to each client: sing-box 1.14.4 mixed HTTP preserves a trailing root dot, while Mihomo may normalize it. The adapters do not claim to normalize native input themselves. ASCII shorthand and CSV comma quantifiers are translated exactly.",
  "clients": {
    "quantumultX": {
      "format": "qx",
      "nativeRegex": false,
      "wildcard": "basic",
      "documentation": [
        "https://raw.githubusercontent.com/crossutility/Quantumult-X/master/sample.conf"
      ],
      "limitation": "Only proven equivalent * / ? expansions are emitted. No host-regex type is documented."
    },
    "surge": {
      "format": "classical",
      "nativeRegex": false,
      "wildcard": "classes",
      "documentation": [
        "https://manual.nssurge.com/rules/domain.html"
      ],
      "limitation": "Only proven equivalent wildcard expansions are emitted. URL-REGEX is not equivalent to a domain condition for all protocols."
    },
    "loon": {
      "format": "classical",
      "nativeRegex": false,
      "wildcard": "classes",
      "minimumBuild": 1008,
      "documentation": [
        "https://nsloon.app/en/docs/Rule/domain_rule/"
      ],
      "limitation": "DOMAIN-WILDCARD character classes require build 1008+. No domain-regex type is documented."
    },
    "shadowrocket": {
      "format": "classical",
      "nativeRegex": false,
      "wildcard": "basic",
      "documentation": [
        "https://apps.apple.com/us/app/shadowrocket/id932747118",
        "https://shadowlaunch.com/",
        "https://t.me/ShadowrocketApp",
        "https://t.me/s/ShadowrocketNews?before=964"
      ],
      "limitation": "Only proven equivalent * / ? expansions are emitted, requiring 2.2.65+. No domain-regex type or wildcard character classes are documented. URL-REGEX is not substituted for all-protocol domain conditions.",
      "minimumVersion": "2.2.65",
      "evidence": "The App Store links the developer site shadowlaunch.com, which links the official ShadowrocketApp group; its profile identifies ShadowrocketNews as the announcement channel. The channel documents build 2613 DOMAIN-WILDCARD with * and ? and the 2.2.65 stable release. No domain-regex or character-class capability is inferred."
    },
    "egern": {
      "format": "egern",
      "nativeRegex": true,
      "wildcard": null,
      "documentation": [
        "https://egernapp.com/docs/configuration/rules/"
      ],
      "limitation": null
    },
    "stash": {
      "format": "classical-yaml",
      "nativeRegex": true,
      "wildcard": null,
      "documentation": [
        "https://stash.wiki/en/rules/rule-types"
      ],
      "limitation": null
    },
    "mihomo": {
      "format": "classical-yaml",
      "nativeRegex": true,
      "wildcard": null,
      "documentation": [
        "https://wiki.metacubex.one/en/config/rules/",
        "https://raw.githubusercontent.com/MetaCubeX/mihomo/v1.19.33/rules/common/domain_regex.go"
      ],
      "limitation": null,
      "engine": "regexp2 with IgnoreCase; equivalence is explicitly scoped to normalized lowercase ASCII DNS hostnames"
    },
    "singBox": {
      "format": "singBox",
      "nativeRegex": true,
      "wildcard": null,
      "documentation": [
        "https://sing-box.sagernet.org/configuration/rule-set/headless-rule/"
      ],
      "limitation": null,
      "engine": "Go regexp (RE2 syntax)",
      "hostNormalization": "Real mixed-HTTP verification: a trailing root dot is retained and can prevent an anchored source regex from matching. No stripping is implemented or claimed."
    }
  },
  "expressions": [
    {
      "file": "openai",
      "rule": "regexp:^chatgpt-async-webps-prod-\\S+-\\d+\\.webpubsub\\.azure\\.com$",
      "positive": [
        "chatgpt-async-webps-prod-a-1.webpubsub.azure.com",
        "chatgpt-async-webps-prod-x.y-123.webpubsub.azure.com"
      ],
      "negative": [
        "chatgpt-async-webps-prod--1.webpubsub.azure.com",
        "chatgpt-async-webps-prod-a-x.webpubsub.azure.com",
        "evil.chatgpt-async-webps-prod-a-1.webpubsub.azure.com",
        "chatgpt-async-webps-prod-a-1.webpubsub.azure.com.evil"
      ]
    },
    {
