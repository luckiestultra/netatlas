#!name = NetAtlas Redirects
#!desc = Optional official-site, HTTP upgrade and Google China redirects; existing trusted MITM CA required for listed HTTPS hosts.
#!author = blackmatrix7, NetAtlas contributors
#!loon_version = 3.5.1(978)
#!date = 2026-10-31
# SPDX-License-Identifier: GPL-2.0-only
# Adapted from Redirect by blackmatrix7 (GPL-2.0); separate from repository MIT-licensed code.
# Changed by NetAtlas on 2026-10-31: finite exact aliases, URL safeguards, no HTTP destination downgrades; region actions separated.
# Complete original source: https://raw.githubusercontent.com/luckiestultra/netatlas/main/src/features/redirects/upstream/Redirect.conf.txt
# Source SHA-256: 85311fcf996fbaf7279daba3ec4c3cff31d6035d333ae6b3c939d86039d16357
# Changes and limitations: https://raw.githubusercontent.com/luckiestultra/netatlas/main/src/features/redirects/NOTICE.md
# Full GPL version 2 license: https://raw.githubusercontent.com/luckiestultra/netatlas/main/src/features/redirects/LICENSE
# Provided WITHOUT ANY WARRANTY; see the GNU General Public License for details.
# Optional; absent from default profiles. Importing opts in to the listed redirects and exact HTTPS MITM hosts.
# Requires your existing trusted MITM CA; no CA, certificate, runtime script, storage or background request is supplied.
# Native app import/interception has not been run. A 302 can change a followed non-GET method.

[Rewrite]
request if ${url} ~= /^http:\/\/(?:aicoin\.cn|www\.aicoin\.cn)\/(?![\s\S])/ as redirect then redirect(302, "https://www.aicoin.com/")
