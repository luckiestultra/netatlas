#!name = NetAtlas HTTPS Upgrade
#!desc = Optional six-host HTTP to HTTPS redirects; no MITM required.
#!author = blackmatrix7, NetAtlas contributors
#!loon_version = 3.5.1(978)
#!date = 2026-10-31
# SPDX-License-Identifier: GPL-2.0-only
# Adapted from Redirect by blackmatrix7 (GPL-2.0), not covered by the repository MIT license.
# Changed by NetAtlas on 2026-10-31: keep six same-host HTTP upgrades; preserve path and query.
# Complete upstream source, modifications and license: https://raw.githubusercontent.com/luckiestultra/netatlas/main/src/features/https-upgrade/
# License: https://raw.githubusercontent.com/luckiestultra/netatlas/main/src/features/https-upgrade/LICENSE
# Provided WITHOUT ANY WARRANTY; see the GNU General Public License for details.
# Optional; not included in default profiles. Importing this resource enables its redirects.
# Only HTTP URLs are matched. No MITM certificate, script, storage or background request is used.
# A 302 may change a non-GET method when the caller follows it. This is not HSTS.

[Rewrite]
request if ${url} ~= /^http:\/\/(www\.jd\.com)(\/[^\s#]*)(?![\s\S])/ as target then redirect(302, "https://${target.1}${target.2}")
request if ${url} ~= /^http:\/\/(www\.mi\.com)(\/[^\s#]*)(?![\s\S])/ as target then redirect(302, "https://${target.1}${target.2}")
request if ${url} ~= /^http:\/\/(suning\.com)(\/[^\s#]*)(?![\s\S])/ as target then redirect(302, "https://${target.1}${target.2}")
request if ${url} ~= /^http:\/\/(taobao\.com)(\/[^\s#]*)(?![\s\S])/ as target then redirect(302, "https://${target.1}${target.2}")
request if ${url} ~= /^http:\/\/(yhd\.com)(\/[^\s#]*)(?![\s\S])/ as target then redirect(302, "https://${target.1}${target.2}")
request if ${url} ~= /^http:\/\/(you\.163\.com)(\/[^\s#]*)(?![\s\S])/ as target then redirect(302, "https://${target.1}${target.2}")
